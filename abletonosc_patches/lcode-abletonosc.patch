+
+        # L-Code addition: lists the browsable children of a named item (e.g.
+        # a plugin's factory presets, if Live indexes them) so preset names
+        # can be discovered before insert_device() is used to load one.
+        def _find_browser_child(root, name):
+            """Direct-child lookup by name, for path navigation -- unlike
+            insert_device's recursive _find_browser_item, this does NOT
+            require is_loadable (folders like 'VST3' aren't loadable, only
+            leaf devices/presets are) and only looks one level down."""
+            for child in root.children:
+                if child.name == name:
+                    return child
+            return None
+
+        def browse_children(params: Tuple) -> Tuple:
+            path = list(params)
+            browser = Live.Application.get_application().browser
+            roots = {
+                "audio_effects": browser.audio_effects, "instruments": browser.instruments,
+                "drums": browser.drums, "max_for_live": browser.max_for_live, "plugins": browser.plugins,
+                "sounds": browser.sounds, "user_library": browser.user_library,
+            }
+            root_name = path[0]
+            item = roots.get(root_name)
+            if item is None:
+                return ("error", f"unknown browser root {root_name!r}")
+            for name in path[1:]:
+                item = _find_browser_child(item, name)
+                if item is None:
+                    return ("error", f"not found: {name!r} under {path}")
+            return tuple(child.name for child in item.children)
+
+        self.osc_server.add_handler("/live/browser/children", browse_children)
